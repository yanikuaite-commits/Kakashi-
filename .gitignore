node_modules/
tmp/
bin/yt-dlp
bin/yt-dlp.exe

# Sessão do WhatsApp (chaves privadas do pareamento). Cada instalação cria a
# sua em tempo de execução; ela não deve ir para o repositório.
assets/auth/

# Configuração de execução: guarda os tokens definidos por `.set-github-token` e
# `.set-spider-api-token`. O bot cria o ficheiro vazio no primeiro acesso, por
# isso ele não precisa de ser versionado — e não pode, senão o token que o dono
# define pelo WhatsApp acaba publicado no repositório.
database/config.json

# Estado de execução: nasce em tempo de execução e só faz sentido na instalação
# que o criou. O `activity.json` e o `blacklist.json` guardam LIDs de usuários
# reais — versioná-los publicaria quem usa o bot e quem foi banido.
database/activity.json
database/blacklist.json
database/system-samples.json
database/backup-state.json
database/credits.json
database/subscriptions.json
database/pending-recharges.json
database/rate-limit.json
